flowchart TD
 A([!미세먼지 / !특보]) --> B{명령}
 B -- 미세먼지 --> C{내일 여부}
 C -- 오늘 --> D[에어코리아 시도별 실시간 측정소]
 D --> E[대표 측정소 원본값 · 20분 캐시]
 E --> F[등급 판정 + 마스크 안내]
 C -- 내일 --> G[예보통보 권역 문구]
 B -- 특보 --> H[기상특보 getPwnStatus 전국 1건 · 5분 캐시]
 H --> I[시·도 이름으로 거르기]
 I --> J{발효 중 특보}
 J -- 있음 --> K[현재 발효 · 예비특보 안내]
 J -- 없음 --> L[발효 중인 특보 없음]
 D -- 키 없음·실패 --> M[승인 안 됨·조회 실패 안내]
 F --> N([200자 이내 전송])
 G --> N
 K --> N
 L --> N
 M --> N