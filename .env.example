HOST=127.0.0.1
PORT=4310
# Public HTTPS origin; must match the Spoon app's redirect URL + /oauth/callback.
PUBLIC_URL=http://localhost:4310
SPOON_CLIENT_ID=
SPOON_CLIENT_SECRET=
# Required for production: generate 32 bytes, encode as 64 hex characters.
TOKEN_KEY=
NODE_ENV=development
# Set to 1 only when running behind a trusted HTTPS reverse proxy (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
# Optional: custom data directory (DB, voice files, daily backups in data/backups).
# DATA_DIR=
# Spoon region the developer app is registered in: kr (Korea, default) or jp (Japan).
SPOON_REGION=kr

# Voice retention in days: 0 keeps messages until DJ deletes them.
VOICE_RETENTION_DAYS=0

# Optional isolated public preview (in-memory, per visitor, expires after 1 hour).
PUBLIC_DEMO=false

# Optional: YouTube Data API v3 key for song-title search (server only).
YOUTUBE_API_KEY=

# Server-only Naver local search credentials.
NAVER_SEARCH_PROVIDER=hub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Weather source: kma (KMA 동네예보, no key needed; falls back to Open-Meteo) or openmeteo (model data only).
WEATHER_SOURCE=kma
# Optional KMA service key (server-only). One data.go.kr key serves, once each is applied for ("활용신청"):
#   "기상청_중기예보 조회서비스"  -> next-week weather (day +4~+10)
#   "기상청_단기예보 조회서비스"  -> fallback when the 동네예보 RSS fails, observed current temperature (초단기실황), today's exact min/max
# Use the Decoding key (data.go.kr) or issue one at apihub.kma.go.kr.
KMA_SERVICE_KEY=
# KMA_API_BASE=https://apis.data.go.kr/1360000
# KMA_API_KEY_PARAM=serviceKey
# Region used by !시간별 / !우산 / !옷차림 / !일출 / !브리핑 when the listener does not name one (default 서울).
# WEATHER_DEFAULT_REGION=서울
# Server-only conversational AI (separate OpenAI API billing).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# One-time automatic operations profile for newly connected DJ rooms.
AUTO_OPERATIONS=0
