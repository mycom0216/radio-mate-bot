HOST=127.0.0.1
PORT=4310
# Public HTTPS origin; must match the Spoon app's redirect URL + /oauth/callback.
PUBLIC_URL=http://localhost:4310
SPOON_CLIENT_ID=
SPOON_CLIENT_SECRET=
# Required for production: generate 32 bytes, encode as 64 hex characters.
TOKEN_KEY=
NODE_ENV=development
# Set to 1 only when running behind a trusted HTTPS reverse proxy (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
# Optional: custom data directory (DB, voice files, daily backups in data/backups).
# DATA_DIR=
# Spoon region the developer app is registered in: kr (Korea, default) or jp (Japan).
SPOON_REGION=kr

# Voice retention in days: 0 keeps messages until DJ deletes them.
VOICE_RETENTION_DAYS=0

# Optional isolated public preview (in-memory, per visitor, expires after 1 hour).
PUBLIC_DEMO=false
